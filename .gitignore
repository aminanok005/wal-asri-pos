# Local env — never commit (SKILL.md §6)
.env
.env.local
.env.*.local

# node / pnpm
node_modules/
.pnpm-store/
.turbo/
*.tsbuildinfo

# Frontend build output
#
# `apps/pos-desktop/dist` is the bundle `apps/pos-desktop/src-tauri/tauri.conf.json`
# points at with `build.frontendDist: "../dist"`. It is generated by
# `bun run build` (`vite build`), it is wiped and rebuilt on every run
# (`build.emptyOutDir: true`), and it is a Tauri BUNDLE INPUT — never a
# committed source of truth. Committing it would mean every build produces a
# diff of hashed filenames that says nothing about the code.
#
# Unanchored, so a `dist/` in any workspace is ignored for the same reason:
# no package in this repo publishes a build artifact.
dist/

# Go
/services/api-backend/api-backend
/services/api-backend/bin/
*.test

# Tauri / Rust
target/
apps/pos-desktop/src-tauri/target/

# Expo / Next
.expo/
.next/
out/

# Agent tool scratch space
#
# `.kilo/worktrees/*/.git` is a POINTER FILE, not a repository: it contains
# `gitdir: /home/nisreen/yt-project/.git/worktrees/<name>`, an absolute path into
# a DIFFERENT repo on this machine. Committing it would record a path that is
# meaningless on any other clone, and checking it out there yields a worktree
# reference with no target. Nothing here is source — it is per-machine agent
# state, so it is excluded.
.kilo/

# OS / editor
.DS_Store
*.log

# Local SQLite databases (offline-first POS terminal, src-tauri README.md).
# The schema is in migrations/*.sql; the data files must never be committed.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Cafe POS (wal-asri-pos) — local dev environment
#
# Copy to `.env` before first use. `.env` itself is gitignored.
# Values must match docker-compose.yml exactly.

# --- containerd namespace (see docker-compose.yml isolation contract) ------
CONTAINERD_NAMESPACE=walasri
COMPOSE_PROJECT_NAME=wal-asri-pos

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_PORT=5433
POSTGRES_DB=walasri_db
POSTGRES_USER=wasri_user
POSTGRES_PASSWORD=walasri_local_dev_pw
DATABASE_URL=postgres://wasri_user:walasri_local_dev_pw@localhost:5433/walasri_db?sslmode=disable

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6380
REDIS_PASSWORD=walasri_redis_pw
REDIS_URL=redis://:walasri_redis_pw@localhost:6380/0

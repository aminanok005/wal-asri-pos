{
  "name": "@wasri/api-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types GENERATED from contracts/openapi.yaml. Never hand-edited.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi.yaml -o ./src/index.ts",
    "typecheck": "tsc --noEmit"
  }
}
